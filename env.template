# Shepherd's Guild Pipeline — Environment Variables
# Copy this to .env and fill in your keys

# Anthropic API (for sermon decomposition)
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Voyage AI (for embeddings)
# Required for T2 unit embeddings. Optional for T1 (`t1_ingest.py --embed` only).
VOYAGE_API_KEY=pa-your-key-here

# T1 cheap ingest (`python t1_ingest.py batch fixtures/t1`) needs no keys.
# Do not set ANTHROPIC_API_KEY on that path; T1 will not call it anyway.

# Supabase (for database)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-service-role-key-here

# Cloudflare R2 (for self-hosted sermon audio at sermons-cdn.sermonsteward.com)
# The same three R2_* values are also Worker secrets on sermon-steward-try
# (try.sermonsteward.com presigned PUT). Set them with wrangler secret put —
# do not commit values.
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET=sermon-steward-audio
R2_PUBLIC_BASE=https://sermons-cdn.sermonsteward.com
