# Shepherd's Guild Pipeline — Environment Variables
# Copy this to .env and fill in your keys

# Anthropic API (for sermon decomposition)
ANTHROPIC_API_KEY=sk-ant-xxxxx

# Voyage AI (for embeddings)
# Required for T2. Optional for T1 (`t1_ingest.py --embed` only).
VOYAGE_API_KEY=pa-xxxxx

# T1 (`python t1_ingest.py batch fixtures/t1`) needs no API keys.

# Supabase (for database)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-key

# AssemblyAI (for audio to transcript)
ASSEMBLYAI_API_KEY=your-assemblyai-key
