<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.shepherdsguild.weekly</string>

    <!-- Tuesday 8am America/Chicago — single weekly tick that drives the
         full 9-stage pipeline for every active customer end-to-end:
         discover → scrape → submit → wait → process → artifacts → render
         → deploy → preacher_analysis refresh. -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Weekday</key>
        <integer>2</integer>     <!-- 2 = Tuesday -->
        <key>Hour</key>
        <integer>8</integer>     <!-- 8am -->
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/dad/shepherds-guild/pipeline copy 2/launchd/run_weekly_tuesday.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/dad/shepherds-guild/pipeline copy 2</string>

    <!-- Wrapper writes its own timestamped log under logs/ —
         launchd's stdout/err only capture wrapper-level errors. -->
    <key>StandardOutPath</key>
    <string>/Users/dad/shepherds-guild/pipeline copy 2/logs/launchd-weekly-wrapper.out</string>
    <key>StandardErrorPath</key>
    <string>/Users/dad/shepherds-guild/pipeline copy 2/logs/launchd-weekly-wrapper.err</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/local/bin:/usr/bin:/bin</string>
        <key>LANG</key>
        <string>en_US.UTF-8</string>
    </dict>

    <key>RunAtLoad</key>
    <false/>

    <!-- If the iMac is asleep at the scheduled time, run when it wakes. -->
    <key>StartOnMount</key>
    <false/>
</dict>
</plist>
